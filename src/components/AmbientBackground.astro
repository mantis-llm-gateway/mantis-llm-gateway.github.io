---
// Drifting halftone screen plus a riso grain wash, both fixed behind the page.
// ambient-field.js reads --field-rgb/--field-a off the canvas and handles
// prefers-reduced-motion and document.hidden itself.
---

<canvas id="ambient-field" aria-hidden="true"></canvas>
<div id="ambient-grain" aria-hidden="true"></div>

<script is:inline src="/scripts/ambient-field.js" defer></script>
<script is:inline>
  (function () {
    var el = document.getElementById('ambient-field');
    if (!el) return;
    // the deferred script may not have defined the global yet
    (function start() {
      if (!window.AmbientField) return requestAnimationFrame(start);
      new window.AmbientField(el).set({ mode: 'screen', density: 1, intensity: 1 });
    })();
  })();
</script>

<style>
  /* z-index: -1 keeps both layers behind content without needing a stacking
     context on every section. The page colour is carried by :root so it paints
     below them — see the [data-has-hero] body rule in custom.css. */
  #ambient-field,
  #ambient-grain {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  #ambient-field {
    width: 100%;
    height: 100%;
  }

  /* The design ships --riso-amt 0.5-0.7 and --riso-tint-amt 0.12; the export
     wires both grain layers to the former, which composites to a saturated teal
     rather than a texture. 0.12 is the tint-strength value and reads as paper. */
  #ambient-grain {
    opacity: 0.12;
    background-color: var(--mantis-teal);
    -webkit-mask-image: url('/images/riso-noise.png');
    mask-image: url('/images/riso-noise.png');
    -webkit-mask-size: 200px 200px;
    mask-size: 200px 200px;
    -webkit-mask-repeat: repeat;
    mask-repeat: repeat;
  }
</style>
